{
  "name": "ridevector",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:env-isolation",
    "check:env-isolation": "node ./scripts/check-env-isolation.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
