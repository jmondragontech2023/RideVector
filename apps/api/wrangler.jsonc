{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ridevector-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ENVIRONMENT": "local",
    "SUPABASE_URL": "http://127.0.0.1:54321",
    // Local POC default only (not a secret). Override via .dev.vars if needed.
    // Named remote envs do not set this; POC generation remains ENVIRONMENT=local gated.
    "VALHALLA_BASE_URL": "https://valhalla1.openstreetmap.de",
  },
  "env": {
    "development": {
      "name": "ridevector-api-development",
      "vars": {
        "ENVIRONMENT": "development",
        "SUPABASE_URL": "https://hsokwavqmqlkbtnftoqw.supabase.co",
      },
      "observability": {
        "enabled": true,
      },
    },
    "staging": {
      "name": "ridevector-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "SUPABASE_URL": "https://REPLACE_ME_STAGING_REF.supabase.co",
      },
      "observability": {
        "enabled": true,
      },
    },
    "production": {
      "name": "ridevector-api-production",
      "vars": {
        "ENVIRONMENT": "production",
        "SUPABASE_URL": "https://REPLACE_ME_PRODUCTION_REF.supabase.co",
      },
      "observability": {
        "enabled": true,
      },
    },
  },
}
