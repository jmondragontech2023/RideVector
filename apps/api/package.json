{
  "name": "@ridevector/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:mobile": "wrangler dev",
    "types": "wrangler types",
    "check:types-generated": "node ../../scripts/check-wrangler-types.mjs",
    "deploy:development": "wrangler deploy --env development",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir=dist"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "24.3.0",
    "eslint": "9.34.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4",
    "wrangler": "4.126.0"
  }
}
