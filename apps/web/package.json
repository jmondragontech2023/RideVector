{
  "name": "@ridevector/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:mobile": "RIDEVECTOR_MOBILE_LAN=1 vite --port 5173 --strictPort",
    "dev:mobile:side": "RIDEVECTOR_MOBILE_LAN=1 vite --port 5174 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json --noEmit && vite build"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/leaflet": "1.9.20",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
